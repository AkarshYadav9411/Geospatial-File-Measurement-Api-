# GeoMeasure API - Environment Configuration
# Copy this file to .env and adjust values as needed.

# Application
APP_NAME=GeoMeasure API
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=true

# Server
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=sqlite:///./storage/geomeasure.db

# File Upload
UPLOAD_DIR=./storage/uploads
MAX_UPLOAD_SIZE_MB=50
ALLOWED_EXTENSIONS=.zip,.kml

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
